#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Bundled assets (bundled/, .codex/skills) ship with the install, not the user's
# workspace. Export the install root so stackd + bun resolve them regardless of cwd.
export STACK_INSTALL_ROOT="$SCRIPT_DIR"
for auth_env in "$SCRIPT_DIR/.env"; do
  if [[ -f "$auth_env" && -z "${SYNTH_API_KEY:-}" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$auth_env"
    set +a
    break
  fi
done

stack_reset_tty() {
  printf '\033[?2004l\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1049l\033[2J\033[3J\033[H\033[?25h\033[0m' >&2 || true
}

trap stack_reset_tty EXIT INT TERM HUP

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" || "${1:-}" == "--version" || "${1:-}" == "-V" ]]; then
  exec bun run "$SCRIPT_DIR/src/main.ts" "$@"
fi
if [[ "${1:-}" == "goal" && ( "${2:-}" == "--help" || "${2:-}" == "-h" ) ]]; then
  exec bun run "$SCRIPT_DIR/src/main.ts" "$@"
fi
if [[ "${1:-}" == "auth" || "${1:-}" == "login" || "${1:-}" == "signup" || "${1:-}" == "whoami" ]]; then
  exec bun run "$SCRIPT_DIR/src/main.ts" "$@"
fi
if [[ "${1:-}" == "update" ]]; then
  exec bun run "$SCRIPT_DIR/src/main.ts" "$@"
fi
if [[ "${1:-}" == "artifacts" ]]; then
  exec bun run "$SCRIPT_DIR/src/main.ts" "$@"
fi

exec bun run "$SCRIPT_DIR/src/main.ts" "$@"
